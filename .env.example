# Copy to .env and fill values. This file is git-ignored.

# ── OpenAlgo ────────────────────────────────────────────────────────────
OPENALGO_API_KEY=
OPENALGO_HOST=http://127.0.0.1:5002
OPENALGO_WS_URL=ws://127.0.0.1:8765

# ── Strategy ────────────────────────────────────────────────────────────
STRATEGY_NAME=Strategy
PRODUCT=MIS

# Optional default script for direct docker run (compose sets per-service SCRIPT).
SCRIPT=NIFTY

# ── Index instrument metadata ──────────────────────────────────────────
# These values override broker discovery when set.
NIFTY_STRIKE_STEP=50
NIFTY_OPTION_LOT_SIZE=65
NIFTY_EXPIRY_WEEKDAY=1
NIFTY_EXCHANGE_SPOT=NSE_INDEX
NIFTY_EXCHANGE_OPTIONS=NFO

BANKNIFTY_STRIKE_STEP=100
BANKNIFTY_OPTION_LOT_SIZE=30
BANKNIFTY_EXPIRY_WEEKDAY=1
BANKNIFTY_EXCHANGE_SPOT=NSE_INDEX
BANKNIFTY_EXCHANGE_OPTIONS=NFO

SENSEX_STRIKE_STEP=100
SENSEX_OPTION_LOT_SIZE=20
SENSEX_EXPIRY_WEEKDAY=3
SENSEX_EXCHANGE_SPOT=BSE_INDEX
SENSEX_EXCHANGE_OPTIONS=BFO

