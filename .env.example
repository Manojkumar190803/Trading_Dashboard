# Copy to .env and fill values (this file is auto-loaded on app start
# because .env is git-ignored — secrets never touch the UI).

# ── OpenAlgo (used for live data, funds, positions, orderbook) ──────────
OPENALGO_BASE_URL=http://localhost:5002
OPENALGO_API_KEY=YOUR_OPENALGO_API_KEY

# ── Fyers (only if using the Fyers adapter directly) ────────────────────
FYERS_CLIENT_ID=YOUR_CLIENT_ID
FYERS_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
FYERS_SYMBOL=NSE:NIFTY50-INDEX
FYERS_RESOLUTION=3
FYERS_DAYS=5
USE_FYERS_BROKER=true
DRY_RUN_ORDERS=true

# ── Misc ────────────────────────────────────────────────────────────────
PRODUCT_TYPE=INTRADAY
CSV_PATH=/app/spot_3m.csv

