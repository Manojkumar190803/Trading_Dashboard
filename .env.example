# Copy to .env and fill values. This file is git-ignored.

# ── OpenAlgo ────────────────────────────────────────────────────────────
OPENALGO_API_KEY=
OPENALGO_HOST=http://127.0.0.1:5002
OPENALGO_WS_URL=ws://127.0.0.1:8765

# ── Strategy ────────────────────────────────────────────────────────────
STRATEGY_NAME=Strategy
PRODUCT=MIS

# Optional default script for direct docker run (compose sets per-service SCRIPT).
SCRIPT=NIFTY

